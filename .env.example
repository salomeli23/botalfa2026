# Copia este archivo a .env y completa los valores

# Token de acceso. Para produccion usa un token permanente de "Usuario del sistema" en Meta Business
WHATSAPP_TOKEN=

# ID del numero de telefono (WhatsApp > API Setup en developers.facebook.com)
PHONE_NUMBER_ID=

# Texto que tu inventes. Debe ser el mismo que pongas al configurar el webhook en Meta
VERIFY_TOKEN=mi_token_secreto_123

# App Secret (Configuracion de la app > Basica). Sirve para validar que los mensajes vienen de Meta
APP_SECRET=

# Version de la Graph API. Revisa la version vigente en la documentacion de Meta
GRAPH_VERSION=v21.0

PORT=3000

# --- Conexion por QR (Embedded Signup) ---
FB_APP_ID=
ES_CONFIG_ID=

# Clave para abrir /conectar y el panel /panel (inventala, larga y dificil)
ADMIN_KEY=

# --- Historial de conversaciones (panel y MCP) ---
# En Railway: agrega una base Postgres y usa la referencia ${{Postgres.DATABASE_URL}}.
# Sin esta variable el historial se guarda en memoria y se borra en cada despliegue.
DATABASE_URL=

# Clave del MCP para Claude (inventala, larga y dificil). URL: https://TU-APP/mcp/<MCP_KEY>
MCP_KEY=
